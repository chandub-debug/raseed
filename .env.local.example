# Copy this file to .env.local and fill in your values
# Required: Groq API Key — get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional: change model (defaults to openai/gpt-oss-20b — fastest free-tier model as of Nov 2026)
# Other available models: openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-20b
